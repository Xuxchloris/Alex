{
  "name": "alex-trade-assistant",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Alex 外贸专家 Agent：Hermes 执行内核、长期记忆、真实客户研究与消息工作流",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "alex": "node --env-file-if-exists=.env scripts/alex-agent.mjs",
    "start": "node --use-env-proxy --env-file-if-exists=.env apps/alex/server.mjs",
    "doctor": "node --use-env-proxy --env-file-if-exists=.env scripts/alex-doctor.mjs",
    "gateway:mcp": "node --use-env-proxy --env-file-if-exists=.env services/alex-mcp/index.mjs",
    "demo:record": "node --use-env-proxy scripts/alex-record-demo.mjs",
    "demo:agent": "node scripts/alex-record-agent-demo.mjs",
    "test": "node --use-env-proxy --test --test-concurrency=2 tests/alex/*.test.mjs",
    "backup": "node --use-env-proxy --env-file-if-exists=.env scripts/alex-backup.mjs",
    "smoke:live": "node --use-env-proxy --env-file-if-exists=.env scripts/alex-live-smoke.mjs",
    "test:legacy": "npm test --prefix packages/dsh-sdr",
    "test:hermes": "python -m unittest discover -s integrations/hermes -p test_*.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright-core": "1.63.0"
  }
}
