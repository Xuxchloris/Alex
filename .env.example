# LLM（OpenAI 兼容端点：vLLM / DeepSeek / Qwen 在线均可）
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-local
LLM_MODEL=Qwen2.5-7B-Instruct

# 嵌入模型
EMBED_MODEL=bge-m3

# MCP 插件（JSON 数组；骨架阶段留空即可，见 app/tools/mcp.py）
# 远程 HTTP MCP（url 型）：
# MCP_SERVERS=[{"name":"apollo","url":"https://mcp.apollo.io/mcp","auth":"oauth"},{"name":"clay","url":"https://api.clay.com/v3/mcp","auth":"oauth"}]
# 本地 stdio MCP（command 型，如 AdsPower 浏览器控制）：
# MCP_SERVERS=[{"name":"adspower","command":"npx","args":["local-api-mcp-typescript"]}]
MCP_SERVERS=[]

# 飞书开放平台（自建应用）
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_VERIFICATION_TOKEN=xxxx

# 服务
API_HOST=0.0.0.0
API_PORT=8080

# Alex 智能外贸助手（独立运行，不依赖旧 Python Agent）
# 在环境设置或本机 .env 中安全配置真实密钥，勿提交密钥。
ALEX_LLM_BASE_URL=https://api.deepseek.com/v1
ALEX_LLM_MODEL=deepseek-chat
ALEX_LLM_API_KEY=
ALEX_PORT=3210
# 原生服务默认只监听本机；Docker 的容器 bind/proxy 由 deploy/alex/compose.yaml 配置。
# ALEX_BIND_HOST=127.0.0.1
# 默认数据与备份保存在仓库忽略的 work/alex/。
# ALEX_DATA_DIR=/absolute/path/to/alex-data
# ALEX_BACKUP_DIR=/absolute/path/to/backup-location
# ALEX_CHROMIUM_PATH=/usr/bin/chromium
# ALEX_API_TOKEN=at-least-24-random-characters
# Hermes 通过令牌文件调用本机 Alex，不把令牌写进技能或工具参数。
# ALEX_API_TOKEN_FILE=/absolute/path/to/alex-data/api-token
# MCP 网关和 Hermes 入口使用同一个本机 API。
# ALEX_API_URL=http://127.0.0.1:3210
